__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.DS_Store
.pytest_cache/

# Canary registry. Publishing planted canary addresses would hand a worm author
# a free avoidance list, so the registry must never reach the repo.
watchtower/canaries.json

# Resume cursors are per-operator run state, never shared artifacts.
watchtower/out/cursor.json

# x402-guard (TypeScript, published separately to npm)
x402-guard/node_modules/

# Examples install the published packages to prove they work against what
# is actually shipped, not against the local build. Those installs are
# reproducible from each example's README and do not belong in the repo.
node_modules/
examples/**/package-lock.json
x402-guard/dist/
x402-guard/*.tgz
