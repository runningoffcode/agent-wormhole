{
  "name": "wormhole-x402",
  "version": "0.2.1",
  "description": "Refuse an agent payment (Solana or EVM x402) that does not match what the agent was quoted, and scan the quote's own text for prompt injection before the model reads it. Offline, no RPC.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "x402",
    "solana",
    "agent",
    "ai-agent",
    "payments",
    "security",
    "prompt-injection",
    "agentic-commerce",
    "transaction-security",
    "spl-token",
    "quote-scanning",
    "mcp",
    "x402-security",
    "agent-security"
  ],
  "author": "JuicyD3v",
  "license": "Apache-2.0",
  "type": "module",
  "devDependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "viem": "^2.55.8",
    "vitest": "^4.1.10"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./evm": {
      "types": "./dist/evm.d.ts",
      "import": "./dist/evm.js"
    },
    "./quotetext": {
      "types": "./dist/quotetext.d.ts",
      "import": "./dist/quotetext.js"
    },
    "./sink": {
      "types": "./dist/sink.d.ts",
      "import": "./dist/sink.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://agentwormhole.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runningoffcode/agent-wormhole.git",
    "directory": "x402-guard"
  },
  "bugs": {
    "url": "https://github.com/runningoffcode/agent-wormhole/issues"
  },
  "peerDependencies": {
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.95.0",
    "viem": "^2"
  },
  "peerDependenciesMeta": {
    "@solana/spl-token": {
      "optional": true
    },
    "@solana/web3.js": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  }
}
